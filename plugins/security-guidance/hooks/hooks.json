{
  "description": "Security reminder hook that warns about potential security issues when editing files",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/run-security-hook.sh"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ]
  }
}
